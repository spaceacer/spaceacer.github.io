---
import type { Entry } from '../lib/entries';
import EntryRow from './EntryRow.astro';

interface Props {
  entries: Entry[];
  showSummary?: boolean;
  empty?: string;
}
const { entries, showSummary = false, empty = 'Nothing here yet.' } = Astro.props;
---

{
  entries.length ? (
    <ol class="log">
      {entries.map((e) => (
        <EntryRow entry={e} showSummary={showSummary} />
      ))}
    </ol>
  ) : (
    <p class="muted">{empty}</p>
  )
}

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
</style>
