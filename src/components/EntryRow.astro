---
// One line of the log: date, kind, title, status. Used on every listing page.
import { kinds } from '../data/site';
import { type Entry, urlOf, isoDate } from '../lib/entries';
import Status from './Status.astro';

interface Props {
  entry: Entry;
  showSummary?: boolean;
}
const { entry, showSummary = false } = Astro.props;
const d = entry.data;
---

<li class="row" data-visibility={d.visibility}>
  <time class="mono date" datetime={isoDate(d.published)}>{isoDate(d.published)}</time>
  <span class="mono kind">{kinds[d.kind].label.toLowerCase()}</span>
  {
    d.visibility === 'classified' ? (
      <span class="title classified mono">Classified</span>
    ) : (
      <span class="title">
        <a href={urlOf(entry)}>{d.title}</a>
        {d.visibility === 'preview' && <span class="mono tag-private">sneak peek</span>}
        {showSummary && d.summary && <span class="summary">{d.summary}</span>}
      </span>
    )
  }
  {d.visibility === 'classified' ? <span class="mono status-x">classified</span> : <Status status={d.status} />}
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 7rem 6.5rem minmax(0, 1fr) auto;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .date {
    font-size: var(--t-xs);
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }
  .kind {
    font-size: var(--t-xs);
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 0 0.45rem;
    justify-self: start;
  }
  .title {
    min-width: 0;
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.3;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .summary {
    display: block;
    font-weight: 400;
    font-size: var(--t-sm);
    color: var(--graphite);
    margin-top: 0.2rem;
  }
  .tag-private {
    font-weight: 400;
    font-size: var(--t-xs);
    color: var(--graphite);
    border: 1px dashed var(--graphite);
    padding: 0 0.4rem;
    margin-left: 0.5rem;
    white-space: nowrap;
    vertical-align: 0.15em;
  }
  .classified {
    justify-self: start;
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
    font-size: var(--t-sm);
    letter-spacing: 0.14em;
    padding: 0.1rem 0.6rem;
  }
  .status-x {
    font-size: var(--t-xs);
    color: var(--graphite);
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: auto auto 1fr;
    }
    .title {
      grid-column: 1 / -1;
      order: 3;
    }
    .row > :global(.status),
    .status-x {
      justify-self: end;
    }
  }
</style>
