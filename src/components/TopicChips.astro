---
import { topicSlug } from '../lib/entries';

interface Props {
  topics: { name: string; count?: number }[];
}
const { topics } = Astro.props;
---

<ul class="chips">
  {
    topics.map((t) => (
      <li>
        <a class="mono" href={`/topics/${topicSlug(t.name)}/`}>
          #{t.name}
          {t.count !== undefined && <span class="count">{t.count}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--t-sm);
    color: var(--blue);
    background: var(--sheet);
    border: 1px solid var(--blue);
    padding: 0.3rem 0.7rem;
    text-decoration: none;
  }
  a:hover {
    background: var(--blue-soft);
  }
  .count {
    font-size: var(--t-xs);
    color: var(--graphite);
  }
</style>
