---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: everything`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap"><header class="site-header">
      <a class="brand mono" href="/">{site.handle}<span class="muted"> / notebook</span></a>
      <nav aria-label="Main">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>Search</a>
          </li>
        </ul>
        <button class="theme" type="button" aria-label="Switch light or dark theme" data-theme-toggle>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="8"></circle>
            <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
          </svg>
        </button>
      </nav>
    </header></div>

    <main id="main" class="wrap">
      <slot />
    </main>

    <div class="wrap"><footer class="site-footer">
      <p class="mono">{site.handle}, kept since 2026</p>
      <ul>
        {site.links.map((l) => <li><a href={l.url} rel="me">{l.label}</a></li>)}
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </footer></div>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem 1rem;
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: 3rem;
  }
  .brand {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: var(--t-sm);
    padding-block: 0.5rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--blue);
    text-decoration: underline;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--sheet);
    color: var(--ink);
    cursor: pointer;
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 5rem;
    padding-block: 1.25rem 3rem;
    border-top: 1.5px solid var(--ink);
    font-size: var(--t-sm);
  }
  .site-footer p {
    margin: 0;
    color: var(--graphite);
  }
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
