---
// Hand-written pages from src/content/pages/ (About, Now, and any you add).
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { isoDate } from '../lib/entries';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <div data-pagefind-body>
  <h1>{page.data.title}</h1>
  {page.data.updated && <p class="mono muted updated">updated {isoDate(page.data.updated)}</p>}
  {
    page.id === 'now' && page.data.items.length > 0 && (
      <ul class="items">
        {page.data.items.map((i) => (
          <li>{i}</li>
        ))}
      </ul>
    )
  }
  <div class="prose">
    <Content />
  </div>
  {
    page.id === 'about' && (
      <ul class="elsewhere">
        {site.links.map((l) => (
          <li>
            <a href={l.url} rel="me">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  </div>
</Base>

<style>
  h1 {
    font-size: var(--t-xl);
    margin-bottom: 0.5rem;
  }
  .updated {
    font-size: var(--t-xs);
    margin: 0 0 2rem;
  }
  .items {
    max-width: var(--measure);
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    padding: 1.25rem 1.25rem 1.25rem 2.5rem;
    margin: 0 0 2rem;
  }
  .items li + li {
    margin-top: 0.4rem;
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .elsewhere a {
    display: inline-block;
    border: 1px solid var(--blue);
    background: var(--sheet);
    padding: 0.5rem 1rem;
    text-decoration: none;
  }
</style>
